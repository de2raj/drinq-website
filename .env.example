# Copy to .env and fill in. Never commit .env.

# Where the site lives (used for payment return links)
SITE_URL=http://localhost:3100

# Orders database (SQLite file)
DATABASE_URL=file:./drinq.db

# PayNow QR (shown at checkout when paying by PayNow)
PAYNOW_UEN=202016031N
PAYNOW_NAME=DRINQSG PTE LTD

# Card / Apple Pay / Google Pay through Stripe Checkout.
# Leave blank to offer PayNow only. Use sk_test_… keys until go-live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Telegram chat or bot link shown on the site
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/

# Password for the /admin orders page (user name: admin)
ADMIN_PASSWORD=
