generator client {
  provider      = "prisma-client-js"
  // native = this Mac; rhel = GoDaddy cPanel (CloudLinux); debian = most other Linux servers
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A web order. Amounts are in cents (SGD). DRINQ is not GST-registered: prices are nett.
model Order {
  id              Int         @id @default(autoincrement())
  number          String      @unique // DQW-00001
  token           String      @unique // private link for the customer's order page
  status          String      @default("AWAITING_PAYMENT") // AWAITING_PAYMENT | PAID | CANCELLED
  paymentMethod   String // PAYNOW | CARD
  stripeSessionId String?
  paidAt          DateTime?
  name            String
  email           String
  phone           String
  address         String
  unit            String      @default("")
  postal          String
  deliveryDate    String // YYYY-MM-DD, Singapore time
  deliverySlot    String // e.g. 10:00-13:00
  notes           String      @default("")
  subtotal        Int
  deliveryFee     Int
  total           Int
  lines           OrderLine[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderLine {
  id        Int    @id @default(autoincrement())
  orderId   Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  sku       String @default("")
  name      String
  size      String @default("")
  unitPrice Int
  qty       Int
  lineTotal Int
}

model Counter {
  name  String @id
  value Int
}

/// A product in the shop, edited in /admin. Prices in cents (SGD, nett). Seeded from data/catalogue.json on first start.
model Product {
  id         String   @id @default(cuid())
  sku        String   @default("")
  slug       String   @unique
  name       String
  brand      String   @default("")
  size       String   @default("")
  price      Int
  was        Int      @default(0) // regular price; above `price` = on sale
  categories String   @default("") // category names joined with "|"
  image      String   @default("") // URL: botello.sg photo, or /img/<id> for an uploaded one
  thumb      String   @default("")
  inStock    Boolean  @default(true)
  active     Boolean  @default(true) // false = hidden from the shop
  rank       Int      @default(0) // "Best selling" order, lower first
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// A product photo uploaded in /admin (kept in the database so it survives redeploys).
model ProductImage {
  id        String   @id @default(cuid())
  type      String
  data      Bytes
  createdAt DateTime @default(now())
}
