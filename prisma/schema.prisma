generator client {
  provider      = "prisma-client-js"
  // native = this Mac; rhel = GoDaddy cPanel (CloudLinux); debian = most other Linux servers
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A web order. Amounts are in cents (SGD). DRINQ is not GST-registered: prices are nett.
model Order {
  id              Int         @id @default(autoincrement())
  number          String      @unique // DQW-00001
  token           String      @unique // private link for the customer's order page
  status          String      @default("AWAITING_PAYMENT") // see src/lib/order-status.ts
  paymentMethod   String // PAYNOW | CARD | APPLE_PAY | GOOGLE_PAY | GRABPAY| CARD
  stripeSessionId String?
  paidAt          DateTime?
  name            String
  email           String
  phone           String
  address         String
  unit            String      @default("")
  postal          String
  deliveryMethod  String      @default("") // NEXT_DAY | SAME_DAY | EXPRESS | COLLECT
  deliveryLabel   String      @default("") // the option's name when ordered, e.g. "Next Day Delivery"
  deliveryDate    String // YYYY-MM-DD (Singapore) or ""
  deliverySlot    String // free text shown to the customer, e.g. "11:00 - 23:00"
  notes           String      @default("")
  subtotal        Int
  deliveryFee     Int
  total           Int
  lines           OrderLine[]
  events          OrderEvent[]
  adminNote       String? // @text staff-only note
  isTest          Boolean     @default(false) // placed on the test site
  customerId      Int? // the customer record (linked by email, else phone)
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pointsUsed      Int         @default(0) // loyalty points taken off this order
  pointsDiscount  Int         @default(0) // cents off for those points
  pointsEarned    Int         @default(0) // points given when paid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderLine {
  id        Int    @id @default(autoincrement())
  orderId   Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  sku       String @default("")
  name      String
  size      String @default("")
  unitPrice Int
  qty       Int
  lineTotal Int
}

model Counter {
  name  String @id
  value Int
}

/// A product in the shop, edited in /admin. Prices in cents (SGD, nett). Seeded from data/catalogue.json on first start.
model Product {
  id         String   @id @default(cuid())
  sku        String   @default("")
  slug       String   @unique
  name       String
  brand      String   @default("")
  size       String   @default("")
  price      Int
  was        Int      @default(0) // regular price; above `price` = on sale
  categories String   @default("") // category names joined with "|"
  image      String   @default("") // URL: botello.sg photo, or /img/<id> for an uploaded one
  thumb      String   @default("")
  inStock    Boolean  @default(true)
  active     Boolean  @default(true) // false = hidden from the shop
  rank       Int      @default(0) // "Best selling" order, lower first
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// A product photo uploaded in /admin (kept in the database so it survives redeploys).
model ProductImage {
  id        String   @id @default(cuid())
  type      String
  data      Bytes
  createdAt DateTime @default(now())
}

/// Status changes and staff notes on an order (the tracking timeline).
model OrderEvent {
  id      Int      @id @default(autoincrement())
  orderId Int
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  String
  note    String? // @text
  at      DateTime @default(now())

  @@index([orderId])
}

/// Shop settings edited in /admin/settings (JSON per key).
model Setting {
  key       String   @id
  value     String // @text JSON
  updatedAt DateTime @updatedAt
}

/// A shopper: created on their first order (guest), or when they sign up. The CRM in /admin/customers.
model Customer {
  id           Int           @id @default(autoincrement())
  email        String?       @unique
  name         String        @default("")
  phone        String        @default("")
  address      String        @default("")
  unit         String        @default("")
  postal       String        @default("")
  birthday     String        @default("") // YYYY-MM-DD
  passwordHash String        @default("") // blank = guest (no account yet)
  tags         String        @default("") // joined with "|", e.g. VIP|Corporate
  marketing    Boolean       @default(false) // agreed to offers
  notes        String? // @text staff-only notes
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  points       PointsEntry[]

  @@index([phone])
}

/// The loyalty points ledger: + earned / given back, − used / taken back. Balance = what's left of unexpired + entries.
model PointsEntry {
  id         Int       @id @default(autoincrement())
  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    Int?
  change     Int
  reason     String
  expiresAt  DateTime?
  by         String    @default("") // "staff" for hand adjustments
  createdAt  DateTime  @default(now())

  @@index([customerId])
}
